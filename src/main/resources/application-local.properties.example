# Copier ce fichier en application-local.properties (gitignoré) et renseigner les valeurs.
# Sans lui, l'application ne démarre pas (spring.profiles.active=local).

# Base de données MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/mon_projet
spring.datasource.username=CHANGER_MOI
spring.datasource.password=CHANGER_MOI

# Secret JWT : 32 caractères minimum, aléatoire.
# S'il est absent, une clé est générée à chaque démarrage et tous les
# utilisateurs sont déconnectés au redémarrage.
app.jwt.secret=CHANGER_MOI_32_CARACTERES_MINIMUM

# Clé API Anthropic (rapport du journal de travail) — optionnelle
anthropic.api.key=
